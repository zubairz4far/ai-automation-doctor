APP_NAME=AI Automation Doctor
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=20
ALLOW_WORKFLOW_MUTATION=false
ALLOW_EXECUTION_RETRY=false
OPERATOR_TOKEN=
MAX_PATCH_OPERATIONS=8
STATE_DB_PATH=./data/ai-automation-doctor.db
REMEDIATION_LEASE_SECONDS=30

# Advisory AI diagnosis is disabled by default. When enabled, only privacy-minimized
# failure metadata is sent and deterministic retry/patch decisions remain authoritative.
AI_DIAGNOSIS_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_BASELINE_CONFIDENCE_THRESHOLD=0.80
